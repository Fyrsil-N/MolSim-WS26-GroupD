# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so20
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# IDE Stuff
.idea/
.vscode/

# Build folders.
# This rule ignores any folder in the project root that contains "build"
/*build*/

# Output folders
# This rule ignores any folder in the project root that contains "output"
/*output*/

# doxygen outputs
/doxygen-output/
